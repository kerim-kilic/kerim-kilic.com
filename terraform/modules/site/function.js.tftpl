// CloudFront Function (viewer-request):
%{ if origin_verify_secret != "" ~}
//  - only accepts requests that carry the secret header Cloudflare adds
%{ endif ~}
%{ if www_redirect ~}
//  - redirects www.<domain> to the apex domain
%{ endif ~}
//  - maps clean URLs to Hugo's index.html files (/articles/foo/ -> /articles/foo/index.html)
function handler(event) {
  var request = event.request;
%{ if origin_verify_secret != "" ~}

  var verify = request.headers['x-origin-verify'];
  if (!verify || verify.value !== '${origin_verify_secret}') {
    return { statusCode: 403, statusDescription: 'Forbidden' };
  }
%{ endif ~}
%{ if www_redirect ~}
  var host = request.headers.host.value;

  if (host.indexOf('www.') === 0) {
    return {
      statusCode: 301,
      statusDescription: 'Moved Permanently',
      headers: { location: { value: 'https://' + host.substring(4) + request.uri + queryString(request.querystring) } }
    };
  }
%{ endif ~}

  var uri = request.uri;
  if (uri.endsWith('/')) {
    request.uri += 'index.html';
  } else if (uri.indexOf('.', uri.lastIndexOf('/')) === -1) {
    request.uri += '/index.html';
  }
  return request;
}
%{ if www_redirect ~}

// Rebuilds the query string for the redirect from CloudFront's parsed form. Keys and values are copied as CloudFront
// provides them; a repeated key arrives once, with all its values in multiValue.
function queryString(query) {
  var parts = [];
  for (var key in query) {
    var values = query[key].multiValue || [query[key]];
    values.forEach(function (v) {
      parts.push(v.value === '' ? key : key + '=' + v.value);
    });
  }
  return parts.length ? '?' + parts.join('&') : '';
}
%{ endif ~}
